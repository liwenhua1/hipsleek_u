// ============================================================
// Sleek Type Union and Standalone Type Annotation Tests
// ============================================================

// Test 1: Simple type annotation alone (no equation)
checkentail x:int |- true.

// Test 2: Type annotation with union type (no equation)
checkentail x:int\/str |- true.

// Test 3: Chained union types (left-associative)
checkentail x:int\/str\/float |- true.

// Test 4: Pointer type annotation alone
checkentail z:int* |- true.

// Test 5: Type annotation with equation (backwards compatibility)
checkentail x:int = x |- x = x.

// Test 6: Union type with equation (backwards compatibility)
checkentail x:int\/str = x |- x:int\/str = x.

// Test 7: Boolean type annotation alone
checkentail b:bool |- true.

// Test 8: Multiple constrained expressions (with AND)
checkentail x:int = 5 & y:int = 10 |- true.


// Test 9: Float type alone
checkentail f:float |- true.

// Test 10: Complex union type chain (4 types)
checkentail v:int\/str\/float\/bool |- true.

// ============================================================
// Additional Test Cases: Type Annotations with Constraints
// ============================================================

// Test 11: Type annotation with arithmetic constraint
checkentail x:int & x > 0 |- true.

// Test 12: Type annotation with comparison (>=)
checkentail x:int & x >= 0 |- true.

// Test 13: Type annotation with comparison (<)
checkentail x:int & x < 10 |- true.

// Test 14: Type annotation with comparison (<=)
checkentail x:int & x <= 100 |- true.

// ============================================================
// User-defined polymorphic types: list[T] and tree[T]
// ============================================================
data list[T] { T hd ; list[T] tl }.
data tree[T] { T val ; tree[T] left ; tree[T] right }.

// Test 15: Polymorphic list type with type variable (provide tl=null for singleton)
checkentail x::list[T]<tl = null> |- true.

// Test 16: Concrete list instance with int element type
checkentail x::list[int]<tl = null> |- true.

// Test 17: Generic list heap shape with tail of same element type
checkentail x::list[T]<tl = null> & y::list[T]<tl = null> |- true.

// Test 18: Polymorphic binary tree node
checkentail x::tree[T]<left = null, right = null> |- true.

// Test 19: Concrete tree instance with int element type
checkentail x::tree[int]<left = null, right = null> |- true.

// Test 20: Type annotation with equality constraint
checkentail x:int & x = 5 |- x = 5.

// Test 21: Type annotation with inequality constraint
checkentail x:int & x != 0 |- x != 0.

// ============================================================
// Multiple Variable Type Constraints
// ============================================================

// Test 22: Two type annotations (using compatible types)
checkentail x:int & y:int |- true.

// Test 23: Three type annotations
checkentail x:int & y:float & z:bool |- true.

// Test 24: Repeated type annotation (idempotent)
checkentail x:int & x:int |- true.

// Test 25: Type annotations with arithmetic operations on multiple variables
checkentail x:int & y:int & x > y |- true.

// ============================================================
// Union Types with Constraints
// ============================================================

// Test 26: Union type annotation (numeric union)
checkentail x:int\/float |- true.

// Test 27: Union type with equality (both types can be equal)
checkentail x:int\/float |- x:int\/float.

// Test 28: Multiple variables with numeric union types
checkentail x:int\/float & y:float\/int |- true.

// Test 29: Multiple union-type expressions
checkentail x:int\/float\/bool |- x:int\/float\/bool.

// ============================================================
// Pointer Type Annotations
// ============================================================

// Test 30: Single pointer type
checkentail p:int* |- true.

// Test 31: Double pointer type
checkentail pp:int** |- true.

// Test 32: Pointer with constraint
checkentail p:int* & p != null |- true.

// ============================================================
// ============================================================
// Type Entailment: Implication Testing
// ============================================================

// Test 33: Type constraint implies value constraint
checkentail x:int |- x:int.

// Test 34: Multiple constraints imply derived constraint
checkentail x:int & x > 0 |- x > 0.

// Test 35: Union type entailment
checkentail x:int\/str |- x:int\/str.

// Test 36: Subtyping - int is subtype of int\/bool
checkentail x:int |- x:int\/bool.

// Test 37: Subtyping - bool is subtype of int\/bool
checkentail x:bool |- x:int\/bool.

// Test 38: Subtyping - int is subtype of NUM (numeric supertype)
checkentail x:int |- x:NUM.

// Test 39: Subtyping - float is subtype of NUM
checkentail x:float |- x:NUM.

// Test 40: Subtyping - intersection implies component types
checkentail x:int/\bool |- x:int.

// Test 41: Subtyping - intersection implies component types (second component)
checkentail x:int/\bool |- x:bool.

// Test 42: Subtyping - intersection implies union of components
checkentail x:int/\bool |- x:int\/bool.

// Test 43: Subtyping - union of intersections
checkentail x:(int/\bool)\/(float/\bool) |- x:int\/bool.

// Test 44: Subtyping - nested union/intersection
checkentail x:int |- x:(int\/bool)/\NUM.

// Test 45: Subtyping with constraints - subtype preserves constraints
checkentail x:int & x > 0 |- x:int\/bool & x > 0.

// ============================================================
// Complex Arithmetic and Type Combinations
// ============================================================

// Test 46: Type annotation with max operation
checkentail x:int & y:int & z = max(x,y) |- true.

// Test 47: Type annotation with min operation
checkentail x:int & y:int & z = min(x,y) |- true.

// Test 48: Type annotation with addition
checkentail x:int & y:int & z = x + y |- true.

// Test 49: Type annotation with subtraction
checkentail x:int & y:int & z = x - y |- true.

// Test 50: Type annotation with multiplication
checkentail x:int & y:int & z = x * y |- true.

// ============================================================
// Complex Logical Combinations
// ============================================================

// Test 51: Multiple constraints combined
checkentail x:int & x > 0 & x < 100 |- x > 0.

// Test 52: Type annotations in complex formulas
checkentail x:int & y:int & (x > y | x = y) |- true.

// ============================================================
// Edge Cases and Special Scenarios
// ============================================================

// Test 53: Type annotation with zero constraints
checkentail x:int & 0 = 0 |- true.

// Test 54: Type annotation consistency check (should always be valid)
checkentail x:int |- x:int.

// Test 55: Mixed union and simple type annotations
checkentail x:int\/str & y:bool |- true.

// Test 56: Chain of constraints with types
checkentail x:int & y:int & z:bool & x > y |- x > y.

// Test 57: Complex expression with nested types (corrected)
checkentail x:int & y:int & z:int & z = x + y |- true.

// ============================================================
// Intersection Type Tests
// ============================================================

// Test 58: Basic intersection type (two types)
checkentail x:int/\str |- true.

// Test 59: Intersection type with three types (left-associative)
checkentail x:int/\str/\bool |- true.

// Test 60: Parenthesized intersection type
checkentail x:(int/\str) |- true.

// Test 61: Intersection type alone (simple)
checkentail a:float/\int |- true.

// Test 62: Intersection type with union (union binds tighter)
checkentail x:(int\/str)/\bool |- true.

// Test 63: Complex combined union and intersection  
checkentail x:int/\str/\float |- true.

// Test 64: Intersection type with int annotations only
checkentail x:int/\int |- true.

// Test 65: Multiple intersection types with constraints
checkentail x:int/\str & y:bool/\float |- true.

// Test 66: Intersection type consistency (true on itself)
checkentail x:int/\str |- x:int/\str.

// ============================================================
// TypeVar Tests: Named Type Variables in Polymorphic Data Types
// ============================================================

// Pair type with two distinct type parameters T and U
data pair[T,U] { T fst ; U snd }.

// Test 67: Polymorphic pair: existential field values with type variables
checkentail x::pair[T,U]<snd = b> |- true.

// Test 68: Polymorphic pair: both fields existentially quantified
checkentail x::pair[T,U]<fst = a, snd = b> |- true.

// Test 69: Tree with type variable in left/right subtrees
checkentail x::tree[T]<left = null, right = null> |- true.

// Test 70: Tree with concrete element type
checkentail x::tree[int]<left = null, right = null> |- true.

// Test 71: Polymorphic list with tl = null (singleton node, type var)
checkentail x::list[T]<tl = null> |- true.

// Test 72: Multiple polymorphic list nodes with same element type
checkentail x::list[T]<tl = null> * y::list[T]<tl = null> |- true.

// Test 73: Two lists with different type variables are independently typed
checkentail x::list[T]<tl = null> * y::list[U]<tl = null> |- true.

// Test 74: linked lists
checkentail x::list[T]<tl = y> * y::list[T]<tl = null> |- true.

// Test 75: linked lists and type parameters
checkentail x::list[T]<tl = y> * y::list[U]<tl = null> |-  x::list[T]<tl = y> * y::list[T]<tl = null>.